{
  "name": "ananth-laxmi-server",
  "private": true,
  "version": "1.0.0",
  "description": "API for Ananth Laxmi Mangal Karalaya: booking enquiries and the admin panel",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch-path=src --watch-path=scripts scripts/dev.js",
    "dev:memory": "node --env-file-if-exists=.env scripts/dev.js --memory",
    "start": "node --env-file-if-exists=.env scripts/dev.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 test/"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  }
}
