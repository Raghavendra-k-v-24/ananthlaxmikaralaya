# Copy this file to .env for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables (never commit the real .env).

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Include the database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ananth-laxmi?retryWrites=true&w=majority

# Long random secret used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The public site and the admin panel, comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://www.ananthlaxmikaralaya.in,https://ananthlaxmikaralaya.in,https://admin.ananthlaxmikaralaya.in

# Local only: `npm run dev:memory` creates this admin in its throw-away database.
# SEED_ADMIN_USERNAME=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=

# ---------- Email (Resend, free up to 3,000 emails a month) ----------
# API key from https://resend.com/api-keys. Without it, no email is sent (it is only logged).
RESEND_API_KEY=
# Sender. The domain must be verified in Resend (Domains → Add domain → add the DNS records).
MAIL_FROM=Ananth Laxmi Mangal Karalaya <bookings@ananthlaxmikaralaya.in>
# Who is told about each new enquiry (comma-separated). Customers' replies also go here.
OWNER_EMAIL=
# Admin panel address, used for the "Open in admin panel" button in the owner's email.
ADMIN_URL=https://admin.ananthlaxmikaralaya.in
# Local only: write unsent emails here as HTML files so you can look at them.
# MAIL_PREVIEW_DIR=.mail-preview
